# Copy to .env (gitignored) and fill in. Real environment variables take precedence.

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
DISCORD_WEBHOOK_URL=

# eBay.ca via the official Browse API (optional; the source stays off without it).
# Free keys: developer.ebay.com -> Application Keys -> Production.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: your postal code, so eBay quotes shipping to you.
EBAY_POSTAL_CODE=
